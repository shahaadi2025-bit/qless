{
  "name": "qless",
  "version": "1.0.0",
  "private": true,
  "description": "Universal Real-Time Queue Infrastructure Platform",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "db:init": "cd server && node scripts/init-db.js",
    "tunnel": "%TEMP%\\cloudflared.exe tunnel --url http://localhost:5173"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
